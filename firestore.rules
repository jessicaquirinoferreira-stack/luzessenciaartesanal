rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'juniorwebcode@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Products collection: public read active items, admin full access
    match /products/{productId} {
      allow read: if resource.data.isActive == true || isAdmin();
      allow write: if isAdmin();
    }

    // Orders collection: public can create order, admin can manage, user can get their created order
    match /orders/{orderId} {
      allow create: if request.resource.data.orderNumber is string &&
                       request.resource.data.customerName is string &&
                       request.resource.data.customerPhone is string &&
                       request.resource.data.items is list &&
                       request.resource.data.subtotal is number &&
                       request.resource.data.total is number &&
                       request.resource.data.status in ['pendente', 'pago', 'enviado', 'entregue', 'cancelado'];
      allow read, update, delete: if isAdmin();
    }

    // Coupons collection: public can read active coupon to validate at checkout, admin can manage
    match /coupons/{couponId} {
      allow read: if resource.data.isActive == true || isAdmin();
      allow write: if isAdmin();
    }

    // Custom party favor quotes: public can create, admin can manage
    match /custom_quotes/{quoteId} {
      allow create: if request.resource.data.name is string &&
                       request.resource.data.phone is string &&
                       request.resource.data.eventType is string &&
                       request.resource.data.quantity is number;
      allow read, update, delete: if isAdmin();
    }

    // Store settings: public read, admin update
    match /site_settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Admin whitelist
    match /admins/{adminId} {
      allow read: if isSignedIn() && (request.auth.uid == adminId || isAdmin());
      allow write: if isAdmin();
    }
  }
}
